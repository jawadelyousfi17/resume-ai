# Copy to .env and fill in. Prisma's CLI reads .env (through prisma.config.ts)
# and so does Next, so one file covers both.


# Required for the AI Tools tab and the "Improve with AI" buttons. The server
# calls Claude Sonnet 5 with this key; it never reaches the browser.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── The public API (/api/v1/extract and /api/mcp) ────────────────────────────
# Comma-separated list of keys allowed to call them. One list opens both doors:
# the REST extractor for programs that read api_docs.md, and the MCP server for
# agents that read the tool descriptions. Unset — or empty — and both answer
# 503 for everyone, which is what a deployment that doesn't want a public API
# should look like. Prefix a key with a label and a colon to name the caller in
# the logs: `myapp:mcv_live_…`. Rotate by listing the new key alongside the old,
# then dropping the old one.
#   openssl rand -hex 24
# MENIACV_API_KEYS=myapp:mcv_live_xxxxxxxx,cli:mcv_live_yyyyyyyy
#
# Requests per minute, per client IP (X-Forwarded-For). Defaults to 20.
# MENIACV_API_RATE_LIMIT=20

# Supabase project. Both are NEXT_PUBLIC_, so they are bundled into the browser
# by design — the publishable key is the one meant to be exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects issue a JWT-shaped anon key instead. Either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only, and never NEXT_PUBLIC_: this one bypasses row-level
# security. Needed so a signed-out visitor's photo can be stored — without it
# their photo stays inside the document. Project settings → API keys →
# secret / service_role.
SUPABASE_SECRET_KEY=

# Postgres. DATABASE_URL is the pooled connection the running app uses;
# DIRECT_URL is the same database without the pooler, which is what Prisma
# Migrate needs — migrations can't run over a transaction pooler.
DATABASE_URL=
DIRECT_URL=

# The origin OAuth providers send users back to. Leave unset in development,
# where it's read from the request. REQUIRED in production and behind a proxy:
# scheme + host, no trailing slash, no path. Unset on a deployment, sign-in
# bounces users to whatever host the request reports — often localhost.
#
# The same origin also has to be allowed on the Supabase side, or the provider
# refuses the callback and Supabase falls back to its dashboard Site URL:
#   Authentication → URL Configuration → Site URL = the value below
#   Authentication → URL Configuration → Redirect URLs = <value below>/auth/callback
# NEXT_PUBLIC_SITE_URL=https://resumeai.example.com

# Optional: where the PDF renderer fetches pages from. Defaults to the site
# origin; set it to the local server (e.g. http://127.0.0.1:3000) when the
# public URL goes through a proxy or CDN.
# PDF_ORIGIN=http://127.0.0.1:3000

# ── Rendering the PDF elsewhere ──────────────────────────────────────────────
# The app can't start a browser on Vercel, so the renderer lives on its own box
# — see build-pdf/. Set all three and /api/compile calls it; leave them unset
# and the PDF is rendered in this process, which is what local development
# does.
#
# PDF_SERVICE_URL=https://pdf.example.com
# PDF_SERVICE_TOKEN=<the renderer's RENDER_TOKEN>
#
# Signs the print token, so the job travels in the URL rather than in one
# instance's memory. Required whenever PDF_SERVICE_URL is set.
# PRINT_SECRET=<openssl rand -hex 32>

# ── Which provider answers ───────────────────────────────────────────────────
# "anthropic" (default) or "deepseek". Switching this moves every AI route —
# writing, review, tailoring, cover letters, translation — to the other vendor.
# Resume *parsing* is the exception: PDFs and images are read by Claude
# whatever this says, because DeepSeek's models can't see them.
AI_PROVIDER=anthropic

# Only needed when AI_PROVIDER=deepseek. Reached through DeepSeek's
# Anthropic-compatible endpoint, so it shares the SDK with Claude.
# Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Taking money: Whop ───────────────────────────────────────────────────────
# The paid plans. Leave this whole block unset and the app runs exactly as it
# did before checkout existed: the pricing cards say what's coming, the buttons
# stay shut, and the first hundred accounts still get Ultimate for a year.
#
# Turns the buy buttons on. NEXT_PUBLIC_ because the pricing cards are a client
# component and this is what they draw from — it says nothing secret, only
# whether the shop is open. Set it once the four plans below actually exist:
# true with nothing configured is a button that fails when pressed.
# NEXT_PUBLIC_CHECKOUT_ENABLED=true
#
# Whop dashboard → Settings. The key builds a checkout per click and reads a
# membership back when a renewal lands; the account is the company the plans
# belong to.
# WHOP_API_KEY=
# WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxxx
#
# Whop dashboard → Developer → Webhooks. Point the endpoint at
# https://<your site>/api/whop/webhook and subscribe it to membership.activated,
# membership.deactivated, membership.cancel_at_period_end_changed and
# payment.succeeded. Without this the route answers 503 and nothing is granted.
# WHOP_WEBHOOK_SECRET=
#
# One per plan and billing cycle, and each is either a plan id (`plan_…`) or a
# checkout link pasted from the dashboard.
#
# Prefer the plan id. The app then builds the checkout itself and stamps it
# with who is buying, so the webhook puts the plan on exactly the right
# account. A pasted link can't carry that: it's a public URL anyone can open,
# so those purchases are matched back by the email the buyer paid with, and one
# bought with a different address lands on nobody and has to be granted by hand
# with `npm run plan`.
#
# A cycle left unset can't be bought — the toggle still shows the price.
# WHOP_PLAN_BASIC_MONTHLY=plan_xxxxxxxxx
# WHOP_PLAN_BASIC_YEARLY=plan_xxxxxxxxx
# WHOP_PLAN_ULTIMATE_MONTHLY=plan_xxxxxxxxx
# WHOP_PLAN_ULTIMATE_YEARLY=plan_xxxxxxxxx
#
# Which billing periods can actually be bought, when checkout is open. Unset
# means both, so this is only written down to restrict — sell monthly while the
# yearly plans don't exist yet and the yearly toggle still shows its price and
# its saving, with the button under it shut and saying why.
# NEXT_PUBLIC_CHECKOUT_CYCLES=monthly
