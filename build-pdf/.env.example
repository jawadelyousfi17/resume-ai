# The port Express listens on.
PORT=4000

# Shared secret. The app sends it as `Authorization: Bearer <token>`; without a
# match the request is refused. Generate one with `openssl rand -hex 32`.
RENDER_TOKEN=1fe49c11d82fa444e6c7edc2f384a544587084797810dd6e09dce98ec2b9f98a1b21a1192772261ef828656d351726f007dc796314582a5fcadff5eb54e7fd79

# Which origins this renderer will open, comma separated. Anything else is
# refused — otherwise the service is an open proxy that will fetch any URL,
# including ones only your VPS can reach.
ALLOWED_ORIGINS=https://maniacv.com,https://www.maniacv.com

# How long one render may take before it's abandoned, in milliseconds.
RENDER_TIMEOUT_MS=30000
