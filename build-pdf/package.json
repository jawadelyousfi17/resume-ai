{
  "name": "maniacv-build-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "The PDF renderer, on its own. Points a headless browser at a print page and returns the file.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "postinstall": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.56.0"
  }
}
